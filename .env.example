# Copy to .env and fill in. Never commit .env.

# --- Public domain (Caddy gets HTTPS for it automatically). Example: shop.example.com
DOMAIN=localhost
# Public URL of the Mini App (opened by the bot button). Must be HTTPS for Telegram.
WEB_APP_URL=https://localhost

# --- Database. In Docker the host is "postgres"; locally it is "localhost".
POSTGRES_USER=vape
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vape
DATABASE_URL=postgresql://vape:vape@localhost:5432/vape
# Integration tests (separate DB, created by docker/postgres-init).
TEST_DATABASE_URL=postgresql://vape:vape@localhost:5432/vape_test
# Run the seed in the Docker "migrate" job (true/false).
SEED=true

# --- Telegram
# Token from @BotFather.
BOT_TOKEN=123456:replace-me
# webhook (production) or polling (local dev).
BOT_MODE=polling
# Full webhook URL: https://<DOMAIN>/telegram/webhook
WEBHOOK_URL=https://localhost/telegram/webhook
# Random string 1-256 chars (A-Z a-z 0-9 _ -). Telegram sends it in a header.
WEBHOOK_SECRET=replace-with-random-secret
# Optional: Telegram user IDs that are always admins (no password needed).
ADMIN_TELEGRAM_IDS=111111111
# Password for the admin panel (Profile → "Вход для администратора"). Min 10 chars.
# Anyone who knows it becomes admin for ADMIN_SESSION_HOURS. Use a long random value.
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_SESSION_HOURS=12
# Chat that receives new-order notifications (manager's user ID or a group ID).
MANAGER_CHAT_ID=111111111
# Manager username without @ (customers write to this account).
MANAGER_USERNAME=VapeHard_manager
# Max age of Telegram initData in seconds.
INIT_DATA_MAX_AGE_SECONDS=3600

# --- Rewards
REWARD_TTL_DAYS=7

# --- S3 / MinIO
# Internal endpoint for server calls.
S3_ENDPOINT=http://localhost:9000
# Public endpoint used to sign browser upload URLs. Behind Caddy: https://<DOMAIN>/media
S3_PUBLIC_ENDPOINT=http://localhost:5173/media
S3_BUCKET=vapehard
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Public base URL for product images (bucket included).
MEDIA_BASE_URL=/media/vapehard

# --- API
API_PORT=3000
LOG_LEVEL=info

# Email for Let's Encrypt (Caddy).
ACME_EMAIL=admin@example.com
