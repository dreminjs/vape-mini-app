// Prisma 7: the connection URL lives in prisma.config.ts, the client uses a driver adapter.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PROCESSING
  HANDED_TO_COURIER
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  COURIER
  EVROPOCHTA
}

enum PrizeType {
  FIXED
  PERCENT
  GIFT
}

enum StockReason {
  ORDER
  CANCEL
  ADMIN_ADJUST
  INITIAL
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id             Int       @id @default(autoincrement())
  telegramId     BigInt    @unique
  username       String?
  firstName      String
  lastName       String?
  role           Role      @default(CUSTOMER)
  /// Admin access granted by password lasts until this moment (see ADR 0002).
  adminUntil     DateTime?
  ageConfirmedAt DateTime?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())

  orders    Order[]
  rewards   Reward[]
  spins     RouletteSpin[]
  auditLogs AuditLog[]
  stockMoves StockMovement[]
}

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  title     String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id            Int       @id @default(autoincrement())
  name          String
  description   String    @default("")
  categoryId    Int
  priceMinor    Int
  oldPriceMinor Int?
  imageKey      String?
  isActive      Boolean   @default(true)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category Category  @relation(fields: [categoryId], references: [id])
  variants Variant[]

  @@index([categoryId, isActive])
  @@index([isActive, id])
}

model Variant {
  id        Int    @id @default(autoincrement())
  productId Int
  name      String
  /// Check constraint stock >= 0 is added in the migration SQL.
  stock     Int    @default(0)
  sortOrder Int    @default(0)

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  movements  StockMovement[]

  @@unique([productId, name])
  @@index([productId])
}

model Order {
  id                Int            @id @default(autoincrement())
  /// Backed by a Postgres sequence that starts at 1001 (see migration).
  number            Int            @unique @default(autoincrement())
  userId            Int
  status            OrderStatus    @default(PROCESSING)
  deliveryMethod    DeliveryMethod
  deliveryCostMinor Int
  subtotalMinor     Int
  discountMinor     Int
  totalMinor        Int
  contactUsername   String
  rewardId          Int?           @unique
  giftName          String?
  idempotencyKey    String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  reward         Reward?         @relation("OrderReward", fields: [rewardId], references: [id])
  items          OrderItem[]
  stockMovements StockMovement[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id             Int    @id @default(autoincrement())
  orderId        Int
  variantId      Int?
  productName    String
  variantName    String
  unitPriceMinor Int
  qty            Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model RoulettePrize {
  id       Int       @id @default(autoincrement())
  key      String    @unique
  title    String
  label    String
  type     PrizeType
  /// FIXED: kopecks. PERCENT: whole percent. GIFT: 0.
  amount   Int
  /// Out of 1,000,000.
  weight   Int
  color    String
  sortOrder Int      @default(0)
  isActive Boolean   @default(true)

  rewards Reward[]
  spins   RouletteSpin[]
}

model Reward {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  userId    Int
  prizeId   Int
  type      PrizeType
  amount    Int
  giftName  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user  User          @relation(fields: [userId], references: [id])
  prize RoulettePrize @relation(fields: [prizeId], references: [id])
  order Order?        @relation("OrderReward")
  spin  RouletteSpin?

  @@index([userId, usedAt, expiresAt])
  @@index([prizeId])
}

model RouletteSpin {
  id        Int      @id @default(autoincrement())
  userId    Int
  prizeId   Int
  rewardId  Int      @unique
  createdAt DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id])
  prize  RoulettePrize @relation(fields: [prizeId], references: [id])
  reward Reward        @relation(fields: [rewardId], references: [id])

  @@index([userId, createdAt])
  @@index([prizeId])
}

model StockMovement {
  id          Int         @id @default(autoincrement())
  variantId   Int
  delta       Int
  reason      StockReason
  orderId     Int?
  adminUserId Int?
  createdAt   DateTime    @default(now())

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id])
  admin   User?   @relation(fields: [adminUserId], references: [id])

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([adminUserId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  adminUserId Int
  action      String
  entity      String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  admin User @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([entity, entityId])
}

model OutboxMessage {
  id          Int          @id @default(autoincrement())
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())
  sentAt      DateTime?

  @@index([status, availableAt])
}
