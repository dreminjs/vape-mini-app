{
  "name": "@vapehard/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/s3-presigned-post": "3.1148.0",
    "@aws-sdk/s3-request-presigner": "3.1148.0",
    "@hono/node-server": "2.1.4",
    "@hono/zod-validator": "0.9.1",
    "@vapehard/db": "workspace:*",
    "@vapehard/shared": "workspace:*",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@vapehard/config": "workspace:*",
    "pino-pretty": "13.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/app.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ]
}
